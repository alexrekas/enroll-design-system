{
  "name": "@ideacrew/enroll-design-system",
  "version": "0.1.0",
  "type": "module",
  "description": "Tokens-first design system for Enroll App (EA/DC/MA/ME themes)",
  "scripts": {
    "build": "node build.mjs && node build-v2.mjs",
    "build:v2": "node build-v2.mjs",
    "check:contrast": "node contrast-check.mjs",
    "prepare:all": "npm run build && npm run check:contrast && npm run check:sources",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "check:sources": "node check-sources.mjs",
    "check:links": "node check-links.mjs",
    "check:stories": "node check-stories.mjs"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/html-vite": "^10.6.5",
    "axe-core": "^4.14.0",
    "playwright": "^1.56.0",
    "storybook": "^10.6.5",
    "style-dictionary": "^5.7.0",
    "vite": "^6.4.5"
  }
}
