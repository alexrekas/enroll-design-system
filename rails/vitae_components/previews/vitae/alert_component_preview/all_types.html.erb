<div style="display:grid;gap:16px">
  <%= render Vitae::AlertComponent.new(type: :info, title: "Open enrollment ends December 15", message: "Choose a plan by then for coverage starting January 1.") %>
  <%= render Vitae::AlertComponent.new(type: :success, title: "Your plan is selected", message: "Pay your first premium to start coverage.") %>
  <%= render Vitae::AlertComponent.new(type: :warning, title: "We need one more document", message: "Upload proof of income by November 30 to keep your tax credit.") %>
  <%= render Vitae::AlertComponent.new(type: :error, title: "There are 2 problems on this page", message: "Fix the fields marked below, then continue.", dismissible: false) %>
</div>
