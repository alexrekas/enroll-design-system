<% if @href %><a<%= attrs(href: @href, class: css_class, "aria-disabled": (@disabled ? "true" : nil), **@html) %>><% else %><button<%= attrs(type: @type, class: css_class, disabled: @disabled, **@html) %>><% end %><%= icon(@icon_left) if @icon_left %><%= label_text %><%= icon(@icon_right) if @icon_right %><%= (@href ? "</a>" : "</button>").html_safe %>
